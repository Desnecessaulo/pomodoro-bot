# Token do bot (Discord Developer Portal > Bot > Reset Token). NUNCA compartilhe.
DISCORD_TOKEN=

# Application ID (Discord Developer Portal > General Information).
DISCORD_CLIENT_ID=

# Opcional: ID de um servidor para registrar os comandos instantaneamente durante o desenvolvimento.
# Sem ele, os comandos são registrados globalmente (pode levar alguns minutos para aparecer).
DEV_GUILD_ID=

# Opcional: tempos (em minutos). Útil para testar com valores menores.
# POMODORO_MINUTES é a duração padrão quando /pomodoro iniciar é usado sem "minutos" (máximo 59).
POMODORO_MINUTES=25
RESPONSE_TIMEOUT_MINUTES=2

# Opcional: tocar os efeitos sonoros do foco, do fim e da pausa (true/false).
SOUNDS_ENABLED=true

# Opcional: nível de log (debug, info, warn, error).
LOG_LEVEL=info
